{
    "name": "cool-uwm",
    "displayName": "language-cool-uwm",
    "description": "(UWM) Cool (Classroom Object Oriented Language) language support for vscode",
    "version": "0.0.5",
    "publisher": "amir734jj",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "repository": "https://github.com/UWM-COMPSCI-654/vscode-cool-lang",
    "main": "./out/extension",
    "activationEvents": [
        "onLanguage:cool"
    ],
    "contributes": {
        "breakpoints": [{ "language": "cool" }],
        "languages": [{
            "id": "cool",
            "aliases": ["COOL", "cool"],
            "extensions": [".cool"],
            "configuration": "./cool.configuration.json"
        }],
        "grammars": [{
            "language": "cool",
            "scopeName": "source.cool",
            "path": "./syntaxes/cool.json"
        }],
        "commands": [{
            "command": "cool.run",
            "title": "Run COOL Program",
            "category": "COOL",
            "icon": "$(play)"
        }, {
            "command": "cool.debug",
            "title": "Debug COOL Program",
            "category": "COOL",
            "icon": "$(debug-alt)"
        }],
        "keybindings": [{
            "command": "cool.run",
            "key": "ctrl+shift+r",
            "when": "editorLangId == cool"
        }, {
            "command": "cool.debug",
            "key": "ctrl+shift+d",
            "when": "editorLangId == cool"
        }],
        "menus": {
            "editor/title/run": [{
                "command": "cool.run",
                "when": "editorLangId == cool",
                "group": "navigation"
            }, {
                "command": "cool.debug",
                "when": "editorLangId == cool",
                "group": "navigation"
            }]
        },
        "debuggers": [{
            "type": "cool",
            "label": "COOL Debug",
            "languages": ["cool"],
            "configurationAttributes": {
                "launch": {
                    "required": ["program"],
                    "properties": {
                        "program": {
                            "type": "string",
                            "description": "Path to the .cool file to debug",
                            "default": "${file}"
                        },
                        "stopOnEntry": {
                            "type": "boolean",
                            "description": "Stop on the first line of user code",
                            "default": false
                        }
                    }
                }
            },
            "configurationSnippets": [{
                "label": "COOL: Launch",
                "description": "Debug a COOL program",
                "body": {
                    "type": "cool",
                    "request": "launch",
                    "name": "Debug COOL Program",
                    "program": "^\"\\${file}\""
                }
            }],
            "initialConfigurations": [{
                "type": "cool",
                "request": "launch",
                "name": "Debug COOL Program",
                "program": "${file}"
            }]
        }]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
        "build-server": "node scripts/build-server.js",
        "vscode:prepublish": "npm run bundle"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.0"
    }
}
