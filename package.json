{
    "name": "cool-uwm",
    "displayName": "language-cool-uwm",
    "description": "(UWM) Cool (Classroom Object Oriented Language) language support for vscode",
    "version": "0.0.5",
    "publisher": "amir734jj",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "repository": "https://github.com/UWM-COMPSCI-654/vscode-cool-lang",
    "main": "./out/extension",
    "activationEvents": [
        "onLanguage:cool"
    ],
    "contributes": {
        "languages": [{
            "id": "cool",
            "aliases": ["COOL", "cool"],
            "extensions": [".cool"],
            "configuration": "./cool.configuration.json"
        }],
        "grammars": [{
            "language": "cool",
            "scopeName": "source.cool",
            "path": "./syntaxes/cool.json"
        }],
        "commands": [{
            "command": "cool.run",
            "title": "Run COOL Program",
            "category": "COOL",
            "icon": "$(play)"
        }],
        "keybindings": [{
            "command": "cool.run",
            "key": "f5",
            "when": "editorLangId == cool"
        }],
        "menus": {
            "editor/title/run": [{
                "command": "cool.run",
                "when": "editorLangId == cool",
                "group": "navigation"
            }]
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
        "build-server": "node scripts/build-server.js",
        "vscode:prepublish": "npm run bundle"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.0"
    }
}
